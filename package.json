{
  "name": "@flowchart-sequence-designer/angular",
  "version": "0.4.0",
  "description": "Angular wrapper for flowchart-sequence-designer — renders the React-based diagram editor inside Angular standalone components",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ag-gr-hub/flowchart-sequence-designer-angular.git"
  },
  "keywords": [
    "angular",
    "flowchart",
    "sequence-diagram",
    "diagram-editor",
    "svg"
  ],
  "type": "module",
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src demo/src",
    "test": "jest",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@angular/common": ">=16",
    "@angular/core": ">=16",
    "flowchart-sequence-designer": ">=1.2.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^9.39.4",
    "flowchart-sequence-designer": "^1.2.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ng-packagr": "^21.2.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.0",
    "typescript": "~5.9.3",
    "zone.js": "^0.16.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@babel/core": "^7.29.7",
    "js-yaml": "^4.2.0"
  },
  "homepage": "https://ag-gr-hub.github.io/flowchart-sequence-designer-angular/",
  "bugs": {
    "url": "https://github.com/ag-gr-hub/flowchart-sequence-designer-angular/issues"
  }
}
